rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ──────────────────────────────────────────────
    // HELPERS
    // ──────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    // Retorna o documento do cuidador logado
    function getCuidador() {
      return get(/databases/$(database)/documents/Cuidadores/$(request.auth.uid));
    }

    // Retorna o instituicaoId do cuidador logado
    function userInstituicaoId() {
      return getCuidador().data.instituicaoId;
    }

    // Verifica se o cuidador logado é Admin
    function isAdmin() {
      return getCuidador().data.role == "Admin";
    }

    // ──────────────────────────────────────────────
    // INSTITUIÇÕES
    // ──────────────────────────────────────────────
    match /Instituicoes/{instId} {
      allow read:   if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.criadoPorUid == request.auth.uid;
      allow update: if isAuthenticated() && userInstituicaoId() == instId && isAdmin();
      allow delete: if false;
    }

    // ──────────────────────────────────────────────
    // CUIDADORES (perfil dos usuários)
    // ──────────────────────────────────────────────
    match /Cuidadores/{cuidadorId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == cuidadorId ||
        resource.data.instituicaoId == userInstituicaoId()
      );

      allow create: if isAuthenticated() && request.auth.uid == cuidadorId && (
        (request.resource.data.role == "Admin" && 
         get(/databases/$(database)/documents/Instituicoes/$(request.resource.data.instituicaoId)).data.criadoPorUid == request.auth.uid) ||
        request.resource.data.role == "Cuidador"
      );

      allow update: if isAuthenticated() && (
        (
          request.auth.uid == cuidadorId &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.instituicaoId == resource.data.instituicaoId
        ) ||
        (
          resource.data.instituicaoId == userInstituicaoId() &&
          isAdmin() &&
          request.resource.data.instituicaoId == resource.data.instituicaoId
        )
      );

      allow delete: if false;
    }

    // ──────────────────────────────────────────────
    // PACIENTES (prontuários)
    // ──────────────────────────────────────────────
    match /Pacientes/{pacienteId} {
      allow read, update, delete: if isAuthenticated()
        && resource.data.instituicaoId == userInstituicaoId();

      allow create: if isAuthenticated()
        && request.resource.data.instituicaoId == userInstituicaoId();
    }

    // ──────────────────────────────────────────────
    // LOGS DE ROTINA
    // ──────────────────────────────────────────────
    // • Leitura, criação e atualização: todos da mesma instituição
    // • EXCLUSÃO: Restrita exclusivamente a Administradores (role == "Admin")
    match /LogsRotina/{logId} {
      allow read, update: if isAuthenticated()
        && resource.data.instituicaoId == userInstituicaoId();

      allow create: if isAuthenticated()
        && request.resource.data.instituicaoId == userInstituicaoId();

      allow delete: if isAuthenticated()
        && resource.data.instituicaoId == userInstituicaoId()
        && isAdmin();
    }

    // ──────────────────────────────────────────────
    // CONSENTIMENTOS LGPD (auditoria)
    // ──────────────────────────────────────────────
    match /ConsentimentosLGPD/{consentId} {
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid;

      allow read: if isAuthenticated()
        && resource.data.instituicaoId == userInstituicaoId();

      allow update, delete: if false;
    }

    // ──────────────────────────────────────────────
    // HISTÓRICO DE INSIGHTS IA
    // ──────────────────────────────────────────────
    match /InsightsHistory/{insightId} {
      allow read: if isAuthenticated()
        && resource.data.instituicaoId == userInstituicaoId();

      allow create: if isAuthenticated()
        && request.resource.data.instituicaoId == userInstituicaoId();

      allow update, delete: if false;
    }

    // ──────────────────────────────────────────────
    // REGRA PADRÃO
    // ──────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
